    <!--###HELP###-->
    <string name="help">Help</string>

    <string name="help_whatis">What is Privacy Friendly 2048?</string>
    <string name="help_whatis_answer">It is an offline version of the classic 2048 puzzle. Your games and statistics are stored on your device.</string>
    <string name="help_color">How do I change the board colors?</string>
    <string name="help_color_answer">Open Settings and choose a board color scheme. You can also change the app theme separately.</string>
    <string name="help_play">What is the goal of this game?</string>
    <string name="help_play_answer">Combine matching numbers to reach 2048. You can choose to keep playing for a higher tile.</string>
    <string name="help_play_how">How do I move the numbers?</string>
    <string name="help_play_how_answer">Swipe across the board in the direction you want all tiles to move.</string>
    <string name="help_play_add">How do I reach higher numbers?</string>
    <string name="help_play_add_answer">When two tiles with the same number meet, they merge into one tile worth twice as much.</string>
    <string name="help_undo">Is it possible to undo steps?</string>
    <string name="help_undo_answer">Tap the curved arrow to undo your most recent move.</string>
    <string name="help_tip">How to beat the game?</string>
    <string name="help_tip_answer">Try keeping your largest tile in one corner and building smaller tiles beside it.</string>
    <string name="help_privacy">What makes the app privacy friendly?</string>
    <string name="help_privacy_answer">The game works offline and has no ads or tracking.</string>
    <string name="help_permission">Does the game need access to personal data?</string>
    <string name="help_permission_answer">The game does not ask for access to your contacts, location, photos, or other personal data to play.</string>

